# SYNAPSE - Variables de Configuración
# Copiar a .env y completar con tus valores
# NUNCA hacer commit de .env a git

# Base de Datos PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/synapse
DB_USERNAME=synapse
DB_PASSWORD=tu_contraseña_aqui

# JWT - Clave para firmar tokens (mín 64 bytes)
JWT_SIGN_KEY=tu-clave-fuerte-minimo-64-bytes

# API Groq Llama (obtén clave en https://console.groq.com)
API_KEY_LLAMA=tu-clave-api-groq

# Opcional
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
JWT_EXPIRATION_MINUTES=1440
