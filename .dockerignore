# ============================================================================
# Docker Build Context Ignore Patterns
# Reduces image build time and size by excluding unnecessary files
# ============================================================================

# Version Control
.git/
.gitignore
.gitattributes

# IDE and Editor
.vscode/
.idea/
*.iml
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Build Artifacts
target/
dist/
build/
node_modules/

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment Files (NEVER include)
.env
.env.local
.env.*.local
.env.production.local

# Testing
coverage/
.nyc_output/

# Package Manager
.yarn/cache/
.npm/
pnpm-lock.yaml
package-lock.json

# Documentation (keep README)
docs/
.github/

# Database
*.db
*.sqlite
*.postgresql.bak

# Uploads and notes (kept in volumes)
uploads/
digital-brain-notes/

# CI/CD
.travis.yml
.gitlab-ci.yml
azure-pipelines.yml

# Miscellaneous
README_*.md
CONTRIBUTING.md
CHANGELOG.md
